#!/bin/bash
set -euxo pipefail

###################################################
## Swap file allocation for RAM overhead protection
###################################################
# pre-allocate 1g empty file named swapfile
fallocate -l 1G /swapfile
# only root user can read or write to this file
chmod 600 /swapfile
# format as swap structure
mkswap /swapfile
# activate swap - turns the swap space on
swapon /swapfile
# make it permanent - appends a configuration line to file system table
echo '/swapfile none swap sw 0 0' >> /etc/fstab

##########################################
## EBS Persistent Volume Format & Mount ##
##########################################
MOUNT_POINT=/data/timescaledb

# Run EBS setup in a subshell so that any failure here logs a warning but does
# NOT abort the rest of user_data (Docker, group setup, compose, etc. still run).
# cloud-init-output.log will show the exact error for diagnosis.
(
  set -euxo pipefail

  # Wait up to 60 seconds for the EBS volume attachment to complete
  DEVICE=""
  for i in $(seq 1 30); do
    for dev in /dev/nvme1n1 /dev/sdf /dev/xvdf; do
      if [ -b "$dev" ]; then
        DEVICE="$dev"
        break 2
      fi
    done
    sleep 2
  done

  if [ -z "$DEVICE" ]; then
    echo "WARNING: Secondary EBS block device not found within 60 seconds — skipping EBS mount." >&2
    exit 1
  fi

  # Format with EXT4 if unformatted
  if ! blkid "$DEVICE"; then
    mkfs.ext4 "$DEVICE"
  fi

  mkdir -p "$MOUNT_POINT"
  mount "$DEVICE" "$MOUNT_POINT"
  # Create subfolder AFTER mounting so it resides on the EBS volume
  mkdir -p "$MOUNT_POINT/pgdata"
  # Ensure postgres container user (UID 999) owns the data subfolder
  chown -R 999:999 "$MOUNT_POINT/pgdata"
  chmod 700 "$MOUNT_POINT/pgdata"


  # Persist mount across reboots via UUID
  UUID=$(blkid -s UUID -o value "$DEVICE")
  echo "UUID=$UUID $MOUNT_POINT ext4 defaults,nofail 0 2" >> /etc/fstab

  echo "EBS volume mounted successfully at $MOUNT_POINT"
) || echo "WARNING: EBS setup failed — continuing without data volume. Check /var/log/cloud-init-output.log."

# Ensure mount point exists even if EBS setup failed (Docker volume mapping needs it)
mkdir -p "$MOUNT_POINT"

###################################################
## Package Dependencies Installation
###################################################

# Note: 'awscli' was removed from Ubuntu 24.04 (Noble) apt repositories.
# Docker Compose v2 is installed as a CLI plugin via the docker.io package.
apt-get update -y
apt-get install -y docker.io docker-compose-v2 wget unzip curl
systemctl enable docker
systemctl start docker

# Wait for Docker daemon to be fully active before proceeding
until systemctl is-active --quiet docker; do sleep 1; done

# Add both the default Ubuntu user and the SSM session user to the docker group
# so that 'docker' commands work without sudo when connecting via SSM Session Manager.
usermod -aG docker ubuntu
# ssm-user is created lazily on first SSM connection — pre-create it so usermod succeeds
id ssm-user &>/dev/null || useradd -m -s /bin/bash ssm-user
usermod -aG docker ssm-user

###################################################
## AWS CLI v2 — Official binary installer
## (awscli apt package removed in Ubuntu 24.04)
###################################################
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp/awscliv2
/tmp/awscliv2/aws/install
rm -rf /tmp/awscliv2.zip /tmp/awscliv2
aws --version

#####################################################
## Fetch Password at Runtime from SSM Parameter Store
#####################################################

DB_PASSWORD=$(aws ssm get-parameter \
    --name "${ssm_param_name}" \
    --with-decryption \
    --region "${aws_region}" \
    --query "Parameter.Value" \
    --output text)

########################################################
## Database Initialization Scripts - Non-Superuser setup
# Files placed in /docker-entrypoint-initdb.d execute automatically on the very first container startup
########################################################

mkdir -p /data/initdb
cat > /data/initdb/01-app-role.sql <<SQL
CREATE USER app_user WITH PASSWORD '$DB_PASSWORD';
CREATE DATABASE iot_telemetry OWNER app_user;
\c iot_telemetry
CREATE EXTENSION IF NOT EXISTS timescaledb;

-- Create the base telemetry table
CREATE TABLE IF NOT EXISTS sensor_telemetry (
    time        TIMESTAMPTZ       NOT NULL,
    device_id   VARCHAR(64)       NOT NULL,
    temperature DOUBLE PRECISION  NULL,
    humidity    DOUBLE PRECISION  NULL,
    battery     DOUBLE PRECISION  NULL,
    status      VARCHAR(32)       NULL
);

-- Convert standard table into a TimescaleDB Hypertable partitioned by 'time'
SELECT create_hypertable('sensor_telemetry', 'time', if_not_exists => TRUE);
-- Create index for fast lookups by device_id and time
CREATE INDEX IF NOT EXISTS idx_device_time ON sensor_telemetry (device_id, time DESC);
-- Grant privileges to our unprivileged application user
GRANT ALL PRIVILEGES ON DATABASE iot_telemetry TO app_user;
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO app_user;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO app_user;
SQL

#############################################################
## Docker Compose Deployment - Timescaledb + PgBouncer Pooler
#############################################################

mkdir -p /opt/app
cat > /opt/app/docker-compose.yml <<DOCKERCOMPOSE
services:
  timescaledb:
    image: timescale/timescaledb:2.29.0-pg17
    container_name: timescaledb
    restart: unless-stopped
    mem_limit: 700m
    environment:
      POSTGRES_PASSWORD: "$DB_PASSWORD"
    volumes:
      - $MOUNT_POINT/pgdata:/var/lib/postgresql/data
      - /data/initdb:/docker-entrypoint-initdb.d
    networks:
      - internal_net

  pgbouncer:
    image: edoburu/pgbouncer:v1.25.2-p0
    container_name: pgbouncer
    restart: unless-stopped
    ports:
      - "6432:6432"
    environment:
      DB_HOST: timescaledb
      DB_PORT: 5432
      DB_USER: app_user
      DB_PASSWORD: "$DB_PASSWORD"
      DB_NAME: iot_telemetry
      LISTEN_PORT: 6432
      POOL_MODE: transaction
      MAX_CLIENT_CONN: 500
      DEFAULT_POOL_SIZE: 20
      AUTH_TYPE: plain
    depends_on:
      - timescaledb
    networks:
      - internal_net

networks:
  internal_net:
    driver: bridge
DOCKERCOMPOSE

cd /opt/app && docker compose up -d

######################################
## Nightly Logical Backup Script to S3
######################################

## create backup script
# qoutes around the delimiter tell the shell not to evaluate the variables right now
cat > /usr/local/bin/backup-timescaledb.sh <<'BACKUP'
#!/bin/bash
set -euo pipefail

# timestamp generation
TIMESTAMP=$(date +%Y-%m-%d-%H%M%S)

## run database dump
# docker exec timescaledb - execute command inside the timescaledb container
# custom binary format -Fc, compressed, fast and allows pg_restore
# outputs the dump to temporary file /tmp

docker exec timescaledb pg_dump -U postgres -Fc iot_telemetry > "/tmp/backup-$TIMESTAMP.dump"
# upload the local dump file to s3 bucket
aws s3 cp "/tmp/backup-$TIMESTAMP.dump" "s3://${backup_bucket}/timescaledb-backups/backup-$TIMESTAMP.dump"
# delete the temp file
rm "/tmp/backup-$TIMESTAMP.dump"
BACKUP
# make it executable
chmod +x /usr/local/bin/backup-timescaledb.sh

## writes a cron configuration file directly into /etc/cron.d
# Minute 0, Hour 2 (2am) * * * everyday, month, and day of the week
# runs as root system user
echo "0 2 * * * root /usr/local/bin/backup-timescaledb.sh >> /var/log/timescaledb-backup.log 2>&1" > /etc/cron.d/timescaledb-backup

######################################################
## CloudWatch Agent Setup for RAM & DISK Usage Metrics
######################################################
wget -q https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb -O /tmp/cwagent.deb
dpkg -i /tmp/cwagent.deb || true

cat > /opt/aws/amazon-cloudwatch-agent/etc/config.json <<'CWCONFIG'
{
  "metrics": {
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/", "/data/timescaledb"] }
    }
  }
}
CWCONFIG

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/config.json || true
